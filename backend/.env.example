# Immortal Software API — copy to backend/.env and fill secrets

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/immortal
PORT=3000
NODE_ENV=development
API_BASE_URL=http://127.0.0.1:3000

# Must be >= 32 characters each
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,null,http://127.0.0.1:5500

NONCE_TTL_SECONDS=300
ATTEST_MAX_AGE_SEC=120
REQUIRE_HTTPS_CLIENTS=false
DISCORD_WEBHOOK_URL=
APP_VERSION=2.2.0
OFFLINE_GRACE_HOURS=12

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_API_MAX=100
RATE_LIMIT_ACTIVATE_MAX=3
