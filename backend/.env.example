DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/immortal_auth?schema=public"
PORT=3000
NODE_ENV=production
API_BASE_URL=https://your-api-domain.com
JWT_ACCESS_SECRET=GENERATE_64_BYTE_HEX
JWT_REFRESH_SECRET=GENERATE_64_BYTE_HEX_DIFFERENT
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
ALLOWED_ORIGINS=https://your-dashboard.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=STRONG_PASSWORD_HERE
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_API_MAX=100
RATE_LIMIT_ACTIVATE_MAX=3
SESSION_IDLE_TIMEOUT_HOURS=1
SESSION_ABSOLUTE_LIFETIME_DAYS=30
NONCE_TTL_SECONDS=300
